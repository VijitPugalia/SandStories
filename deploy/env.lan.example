# Copy to .env or pass these variables when running docker compose.
LAN_IP=192.168.1.20
SANDSTORIES_OPERATOR_TOKEN=field-console
SANDSTORIES_DEVICE_TOKEN=field-device
LIVEKIT_URL=ws://192.168.1.20:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=sandstories-livekit-development-secret-2026

# Optional automatic Any2Full GPU pipeline.
ANY2FULL_HOST_DIR=C:/Users/vijit/Any2Full
ANY2FULL_CHECKPOINT_HOST_DIR=C:/Users/vijit/Any2Full/checkpoints
ANY2FULL_CHECKPOINT_FILE=Any2Full_vits.pth.tar
SANDSTORIES_ANY2FULL_ENCODER=auto
SANDSTORIES_ANY2FULL_DEPTH_SOURCE=selected
SANDSTORIES_ANY2FULL_TARGET_RESOLUTION=depth
SANDSTORIES_ANY2FULL_STRIDE=10
SANDSTORIES_ANY2FULL_MAX_FRAMES=60
SANDSTORIES_ANY2FULL_DENOISE=false
SANDSTORIES_ANY2FULL_TIMEOUT_SECONDS=3600
